                <Bitmap profile="fs25_menuHeaderIcon" imageSliceId="gui.icon_options_generalSettings2"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" text="$l10n_tp_title"/>
            <Text profile="tornado_statusText" id="statusText" text=""/>
        </GuiElement>

