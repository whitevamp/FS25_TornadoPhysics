<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!--
    Tornado Physics - Control Panel layout.
    Controller: scripts/gui/TornadoMenu.lua (ScreenElement). Each tab's rows are wired up by
    its own page script in scripts/gui/pages/ - the element ids below are the keys those
    scripts look up, so rename them in both places.

    Naming:  tab<Key> = tab button, page<Key> = page container, layout<Key> = scrolling list
    Row callbacks (all dispatched by TornadoMenu.lua to the owning page script):
        BinaryOption    -> onClickBinary
        MultiTextOption -> onClickNumber (value grid) / onClickChoice (named options)
        Button          -> onClickAction

    onOpen/onClose on <GUI> are REQUIRED: Gui:changeScreen() only calls onOpen() on the root
    element, and the root forwards it to the controller through these two callbacks.
    Keep this file plain ASCII. All texts are $l10n_ keys from translations/translation_xx.xml
    (source: tools/translations_source.py).
-->
<GUI name="TornadoMenu" onOpen="onOpen" onClose="onClose">
    <Bitmap profile="fs25_fullScreenBackground" id="backgroundImage" imageColor="0.01681 0.01764 0.016 0.97"/>

    <GuiElement profile="fs25_menuContainer">

