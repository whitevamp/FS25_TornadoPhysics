<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!--
    Tornado Physics - Control Panel GUI profiles.
    Loaded once by TornadoMenu.register() via g_gui:loadProfiles() BEFORE gui/TornadoMenu.xml.

    Everything that is not defined here comes straight from the base game (fs25_* profiles),
    so the panel follows the look of the vanilla settings pages. Only the pieces the base
    game has no profile for (in-row action buttons, status line, note rows) live here.

    Keep this file plain ASCII - non-ASCII characters make the GUI XML loader fail.
-->
<GuiProfiles>

    <!-- ===================================================================
         ACTION BUTTON
         Same construction as the base game's in-row "Pause" button on the settings page:
         a transparent Button (emptyPanel) sitting where a selector would, plus a child
         ThreePartBitmap that draws the rounded background. A plain "noSlice" fill must NOT
         be used here - without an image file it samples the UI texture atlas (speckles).

         XML usage:
           <Button profile="tornado_actionButton" ...>
               <ThreePartBitmap profile="tornado_actionButtonBg"/>
           </Button>
         The child bitmap follows the button's focus / hover / pressed state.
         =================================================================== -->
    <Profile name="tornado_actionButton" extends="emptyPanel" with="anchorMiddleRight">
        <size value="280px 32px"/>
        <position value="-10px 0px"/>
        <focusOnHighlight value="true"/>
        <textSize value="16px"/>
        <textBold value="true"/>
        <textUpperCase value="true"/>
        <textAlignment value="center"/>
        <textColor value="$preset_fs25_colorMainLight"/>
        <textFocusedColor value="$preset_fs25_colorMainDark"/>
        <textHighlightedColor value="$preset_fs25_colorMainDark"/>
        <textPressedColor value="$preset_fs25_colorMainDark"/>
        <textDisabledColor value="$preset_colorDisabled"/>
    </Profile>

    <!-- Destructive actions (resets / kill test): white text on the red highlight. -->
    <Profile name="tornado_actionButtonDanger" extends="tornado_actionButton">
        <textFocusedColor value="1 1 1 1"/>
        <textHighlightedColor value="1 1 1 1"/>
        <textPressedColor value="1 1 1 1"/>
    </Profile>

    <!-- Background: base settings-button artwork, also lit on mouse hover / press. -->
    <Profile name="tornado_actionButtonBg" extends="fs25_settingsButtonBg">
        <imageHighlightedColor value="$preset_fs25_colorMainHighlight"/>
        <imagePressedColor value="$preset_fs25_colorMainHighlight"/>
        <startImageHighlightedColor value="$preset_fs25_colorMainHighlight"/>
        <startImagePressedColor value="$preset_fs25_colorMainHighlight"/>
        <endImageHighlightedColor value="$preset_fs25_colorMainHighlight"/>
        <endImagePressedColor value="$preset_fs25_colorMainHighlight"/>
    </Profile>

    <Profile name="tornado_actionButtonDangerBg" extends="tornado_actionButtonBg">
        <imageFocusedColor value="0.78 0.16 0.12 1"/>
        <imageHighlightedColor value="0.78 0.16 0.12 1"/>
        <imagePressedColor value="0.78 0.16 0.12 1"/>
        <startImageFocusedColor value="0.78 0.16 0.12 1"/>
        <startImageHighlightedColor value="0.78 0.16 0.12 1"/>
        <startImagePressedColor value="0.78 0.16 0.12 1"/>
        <endImageFocusedColor value="0.78 0.16 0.12 1"/>
        <endImageHighlightedColor value="0.78 0.16 0.12 1"/>
        <endImagePressedColor value="0.78 0.16 0.12 1"/>
    </Profile>

    <!-- ===================================================================
         STATUS LINE (header, right of the title)
         Shows the result string of the last change, same text the console prints.
         =================================================================== -->
    <Profile name="tornado_statusText" extends="fs25_textDefault" with="anchorBottomRight">
        <size value="620px 24px"/>
        <position value="0px -26px"/>
        <textSize value="17px"/>
        <textAlignment value="right"/>
        <textColor value="$preset_fs25_colorMainHighlight"/>
    </Profile>

    <!-- ===================================================================
         NOTE ROW (informational line inside a page, no control)
         =================================================================== -->
    <!-- The parent fixes width="450px" (room for a selector on the right); a note row has no
         selector, so it may use the whole 815px row minus the 20px left/right padding.
         Text truncates by default, so allow a second line before anything gets cut. -->
    <Profile name="tornado_noteText" extends="fs25_settingsMultiTextOptionTitle">
        <width value="775px"/>
        <textMaxNumLines value="2"/>
        <textSize value="15px"/>
        <textBold value="false"/>
        <textColor value="$preset_colorWhite_50"/>
    </Profile>

    <!-- ===================================================================
         TABLE (Messages tab; reused by later full-width pages)
         A fixed set of row buttons; scrolling, selection and contents are handled in Lua
         (scripts/gui/TornadoTable.lua). Positions are relative to the page container.
         =================================================================== -->
    <!-- Small top-left button: list switches (Recent / Saved), scroll and detail actions. -->
    <Profile name="tornado_tableButton" extends="tornado_actionButton" with="anchorTopLeft">
        <size value="260px 40px"/>
        <position value="0px 0px"/>
    </Profile>
    <Profile name="tornado_tableButtonDanger" extends="tornado_actionButtonDanger" with="anchorTopLeft">
        <size value="260px 40px"/>
        <position value="0px 0px"/>
    </Profile>

    <!-- Filter selector box: title left, the game's 280px selector against the right edge (-10px).
         360px wide so it ends at 920px, left of the detail panel (940px). -->
    <Profile name="tornado_tableFilterBox" extends="emptyPanel" with="anchorTopLeft">
        <size value="360px 48px"/>
    </Profile>
    <Profile name="tornado_tableFilterTitle" extends="fs25_settingsMultiTextOptionTitle">
        <width value="60px"/>
    </Profile>

    <!-- Table area: header row + the row buttons (the mouse wheel scrolls while the cursor is over it). -->
    <Profile name="tornado_tableArea" extends="emptyPanel" with="anchorTopLeft">
        <size value="900px 620px"/>
    </Profile>
    <Profile name="tornado_tableHeaderText" extends="fs25_textDefault" with="anchorTopLeft">
        <size value="200px 24px"/>
        <textSize value="15px"/>
        <textBold value="true"/>
        <textUpperCase value="true"/>
        <textColor value="$preset_fs25_colorGreyText"/>
    </Profile>

    <!-- One row: transparent focusable button, background bitmap and cell texts as children.
         Hover only highlights; the row is selected on click / controller focus. -->
    <Profile name="tornado_tableRow" extends="emptyPanel" with="anchorTopLeft">
        <size value="900px 44px"/>
        <focusOnHighlight value="false"/>
    </Profile>
    <Profile name="tornado_tableRowBg" extends="fs25_settingsButtonBg">
        <imageColor value="$preset_fs25_colorMainDark"/>
        <imageHighlightedColor value="$preset_fs25_colorGreyLight_50"/>
        <imageSelectedColor value="$preset_fs25_colorMainHighlight"/>
        <startImageHighlightedColor value="$preset_fs25_colorGreyLight_50"/>
        <startImageSelectedColor value="$preset_fs25_colorMainHighlight"/>
        <endImageHighlightedColor value="$preset_fs25_colorGreyLight_50"/>
        <endImageSelectedColor value="$preset_fs25_colorMainHighlight"/>
    </Profile>
    <Profile name="tornado_tableCell" extends="fs25_textDefault" with="anchorMiddleLeft">
        <size value="200px 24px"/>
        <textSize value="15px"/>
        <textMaxNumLines value="1"/>
        <textColor value="$preset_fs25_colorMainLight"/>
        <textFocusedColor value="$preset_fs25_colorMainDark"/>
        <textSelectedColor value="$preset_fs25_colorMainDark"/>
        <textHighlightedColor value="$preset_fs25_colorMainLight"/>
    </Profile>
    <Profile name="tornado_tableCellMark" extends="tornado_tableCell">
        <size value="20px 24px"/>
        <textBold value="true"/>
        <textColor value="$preset_fs25_colorMainHighlight"/>
    </Profile>
    <Profile name="tornado_tableInfoText" extends="fs25_textDefault" with="anchorTopLeft">
        <size value="560px 24px"/>
        <textColor value="$preset_colorWhite_50"/>
    </Profile>

    <!-- Detail panel (right of the table). -->
    <Profile name="tornado_detailTitle" extends="fs25_textDefault" with="anchorTopLeft">
        <size value="560px 30px"/>
        <textSize value="22px"/>
        <textBold value="true"/>
        <textUpperCase value="true"/>
    </Profile>
    <Profile name="tornado_detailLine" extends="fs25_textDefault" with="anchorTopLeft">
        <size value="560px 24px"/>
        <textSize value="16px"/>
        <textVerticalAlignment value="top"/>
        <textColor value="$preset_fs25_colorGreyText"/>
    </Profile>
    <Profile name="tornado_detailBody" extends="fs25_textDefault" with="anchorTopLeft">
        <size value="560px 420px"/>
        <textSize value="17px"/>
        <textMaxNumLines value="18"/>
        <textVerticalAlignment value="top"/>
        <textColor value="$preset_fs25_colorMainLight"/>
    </Profile>

    <!-- ===================================================================
         INSURANCE TAB (side buttons + sections)
         =================================================================== -->
    <Profile name="tornado_navButton" extends="tornado_tableButton">
        <size value="230px 44px"/>
    </Profile>
    <!-- Form rows: the game's row container is plain white; the settings pages tint it from Lua
         (InGameMenuSettingsFrame.COLOR_ALTERNATING). Same colours here, alternating. -->
    <Profile name="tornado_formRow" extends="fs25_multiTextOptionContainer">
        <imageColor value="0.02956 0.02956 0.02956 0.6"/>
    </Profile>
    <Profile name="tornado_formRowAlt" extends="fs25_multiTextOptionContainer">
        <imageColor value="0.02956 0.02956 0.02956 0.2"/>
    </Profile>
    <!-- A section fills the page; only the chosen one is visible. -->
    <Profile name="tornado_section" extends="emptyPanel" with="anchorStretchingYStretchingX"/>
    <Profile name="tornado_noteLine" extends="fs25_textDefault" with="anchorTopLeft">
        <size value="1200px 24px"/>
        <textSize value="16px"/>
        <textColor value="$preset_fs25_colorMainHighlight"/>
        <textVerticalAlignment value="top"/>
    </Profile>
    <!-- Claims table (Insurance tab): narrower than the Messages table, the section buttons sit on its left. -->
    <Profile name="tornado_claimTableArea" extends="tornado_tableArea">
        <size value="680px 510px"/>
    </Profile>
    <Profile name="tornado_claimRow" extends="tornado_tableRow">
        <size value="680px 44px"/>
    </Profile>
    <!-- Coverage info: one long text over the whole section. -->
    <Profile name="tornado_infoBody" extends="tornado_detailBody">
        <size value="1240px 640px"/>
        <textMaxNumLines value="30"/>
    </Profile>
    <!-- Payments chart: premiums vs. payouts per month. Bars stand on the area's bottom (baseReference = plain
         colour image); their XML height is the full height, the page scales them. -->
    <Profile name="tornado_chartArea" extends="emptyPanel" with="anchorTopLeft">
        <size value="540px 176px"/>
    </Profile>
    <Profile name="tornado_chartBarPremium" extends="baseReference" with="anchorBottomLeft">
        <size value="16px 132px"/>
        <imageColor value="0.85 0.42 0.12 1"/>
    </Profile>
    <Profile name="tornado_chartBarPayout" extends="tornado_chartBarPremium">
        <imageColor value="$preset_fs25_colorMainHighlight"/>
    </Profile>
    <Profile name="tornado_chartKeyPremium" extends="baseReference" with="anchorTopLeft">
        <size value="14px 14px"/>
        <imageColor value="0.85 0.42 0.12 1"/>
    </Profile>
    <Profile name="tornado_chartKeyPayout" extends="tornado_chartKeyPremium">
        <imageColor value="$preset_fs25_colorMainHighlight"/>
    </Profile>
    <Profile name="tornado_chartKeyText" extends="fs25_textDefault" with="anchorTopLeft">
        <size value="100px 22px"/>
        <textSize value="14px"/>
        <textColor value="$preset_fs25_colorMainLight"/>
    </Profile>
    <Profile name="tornado_chartLabel" extends="fs25_textDefault" with="anchorBottomLeft">
        <size value="45px 20px"/>
        <textSize value="12px"/>
        <textAlignment value="center"/>
        <textColor value="$preset_colorWhite_50"/>
    </Profile>
    <Profile name="tornado_chartMaxText" extends="fs25_textDefault" with="anchorTopRight">
        <size value="200px 20px"/>
        <textSize value="12px"/>
        <textAlignment value="right"/>
        <textColor value="$preset_colorWhite_50"/>
    </Profile>
    <Profile name="tornado_chartEmptyText" extends="fs25_textDefault" with="anchorMiddleCenter">
        <size value="500px 24px"/>
        <textSize value="15px"/>
        <textAlignment value="center"/>
        <textColor value="$preset_colorWhite_50"/>
    </Profile>
    <!-- Note that may need two lines (long translations). -->
    <Profile name="tornado_noteLine2" extends="tornado_noteLine">
        <size value="1220px 48px"/>
        <textMaxNumLines value="2"/>
    </Profile>
    <Profile name="tornado_policyText" extends="tornado_detailBody">
        <size value="880px 130px"/>
        <textMaxNumLines value="5"/>
    </Profile>

</GuiProfiles>
