<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="smokeTrailSubUV" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">

  <Files>
    <File fileId="1" filename="$data/effects/chimneySmoke/smoke16x4_diffuse.png" />
    <File fileId="4" filename="$data/shaders/smokeTrailSubUVShader.xml" />
    <File fileId="2" filename="$data/shared/default_normal.png" />
    <File fileId="3" filename="$data/shared/default_specular.png" />
  </Files>

  <Materials>
    <Material name="smoke16x4_mat1" materialId="1" alphaBlending="true" customShaderId="4">
      <CustomParameter name="playScale" value="30 40 16 4"/>
      <CustomParameter name="widthScale" value="3 4 1.25 0"/>
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
    </Material>
    <Material name="smoke16x4_mat2" materialId="2" alphaBlending="true" customShaderId="4">
      <CustomParameter name="playScale" value="30 40 16 4"/>
      <CustomParameter name="widthScale" value="1 3 0.75 0"/>
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="smokeTrailSubUV.i3d.shapes">
  </Shapes>

  <Scene>
    <Shape name="trail1" shapeId="1" castsShadows="false" receiveShadows="false" doubleSided="true" materialIds="1" objectMask="0xff007f" clipDistance="200" nodeId="1"/>
    <Shape name="trail2" shapeId="2" castsShadows="false" receiveShadows="false" doubleSided="true" materialIds="2" objectMask="0xff007f" clipDistance="200" nodeId="2"/>
  </Scene>

  <UserAttributes>
