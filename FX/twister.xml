    <filename>twister.i3d</filename>

    <fading fadeInDuration="5" fadeOutDuration="2" />
    <speed meterPerSecond="5" />

    <sounds>
        <moving file="$data/sounds/maps/shared/wind/tornado/ambTornadoMoving_01.wav" innerRadius="60.0" outerRadius="120.0" volumeScale="9" >
